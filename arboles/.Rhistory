interaction_specs <- list(
"Stepwise model + head x abdomen" = c("head_mais_group", "abdomen_mais_group"),
"Stepwise model + head x thorax" = c("head_mais_group", "thorax_mais_group")
)
interaction_models <- lapply(interaction_specs, function(regions) {
interaction_formula <- as.formula(
paste(". ~ . +", paste(regions, collapse = " * "))
)
model <- glm(
formula = update(stepwise_refit_formula, interaction_formula),
data = selection_training_data,
family = binomial(link = "logit"),
na.action = na.fail
)
if (!isTRUE(model$converged) || anyNA(coef(model))) {
warning("An interaction model did not converge or has inestimable terms.")
}
model
})
all_interaction_models <- c(
list("Stepwise model (no interaction)" = stepwise_refit_model),
interaction_models
)
# Likelihood-ratio comparison against the stepwise model.
model_comparison_table <- do.call(rbind, lapply(
names(all_interaction_models),
function(model_name) {
model <- all_interaction_models[[model_name]]
is_reference <- identical(model_name, "Stepwise model (no interaction)")
lr_test <- if (is_reference) {
NULL
} else {
anova(stepwise_refit_model, model, test = "Chisq")
}
data.frame(
Model = model_name,
Parameters = length(coef(model)),
AIC = AIC(model),
BIC = BIC(model),
Deviance = deviance(model),
`LR chi-squared` = if (is_reference) NA_real_ else lr_test$Deviance[2],
`LR df` = if (is_reference) NA_real_ else lr_test$Df[2],
`LR p value` = if (is_reference) NA_real_ else lr_test$`Pr(>Chi)`[2],
check.names = FALSE
)
}
))
model_comparison_table[c("AIC", "BIC", "Deviance", "LR chi-squared")] <-
lapply(
model_comparison_table[c("AIC", "BIC", "Deviance", "LR chi-squared")],
round, digits = 2
)
model_comparison_table$`LR p value` <- ifelse(
is.na(model_comparison_table$`LR p value`),
"",
format.pval(model_comparison_table$`LR p value`, digits = 3, eps = 0.001)
)
model_comparison_table[is.na(model_comparison_table)] <- ""
knitr::kable(
model_comparison_table,
align = c("l", rep("r", 7)),
caption = "Stepwise-AIC logistic model compared with models adding a head x abdomen or head x thorax interaction (training sample 2020-2023)"
)
interaction_performance_table <- do.call(rbind, lapply(
names(all_interaction_models),
function(model_name) {
model <- all_interaction_models[[model_name]]
number_of_terms <- length(attr(terms(model), "term.labels"))
rbind(
evaluate_selection_predictions(
method = model_name,
sample_name = "Training (2020-2023)",
observed = selection_training_data$mortality_30d,
predicted_probability = predict(
model, newdata = selection_training_data, type = "response"
),
number_of_selected_predictors = number_of_terms
),
evaluate_selection_predictions(
method = model_name,
sample_name = "Validation (2024-2025)",
observed = selection_test_data$mortality_30d,
predicted_probability = predict(
model, newdata = selection_test_data, type = "response"
),
number_of_selected_predictors = number_of_terms
)
)
}
))
# Paired DeLong test of the validation AUC against the stepwise model.
reference_validation_roc <- pROC::roc(
response = selection_test_data$mortality_30d,
predictor = predict(
stepwise_refit_model, newdata = selection_test_data, type = "response"
),
levels = c(0, 1), direction = "<", quiet = TRUE
)
interaction_auc_p_values <- vapply(
names(all_interaction_models),
function(model_name) {
if (identical(model_name, "Stepwise model (no interaction)")) {
return("")
}
comparison_roc <- pROC::roc(
response = selection_test_data$mortality_30d,
predictor = predict(
all_interaction_models[[model_name]],
newdata = selection_test_data, type = "response"
),
levels = c(0, 1), direction = "<", quiet = TRUE
)
format.pval(
pROC::roc.test(
reference_validation_roc, comparison_roc, method = "delong"
)$p.value,
digits = 3, eps = 0.001
)
},
character(1)
)
interaction_performance_table$`DeLong p vs stepwise (validation)` <- ifelse(
grepl("^Validation", interaction_performance_table$Sample),
interaction_auc_p_values[interaction_performance_table$Method],
""
)
interaction_performance_table[performance_columns] <- lapply(
interaction_performance_table[performance_columns],
round,
digits = 3
)
