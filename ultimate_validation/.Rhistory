selection_formula,
data = selection_training_data
)
training_design_matrix <- training_design_matrix_full[, -1, drop = FALSE]
training_outcome <- selection_training_data[[outcome_variable]]
design_assignment <- attr(training_design_matrix_full, "assign")[-1]
selection_term_labels <- attr(terms(selection_formula), "term.labels")
set.seed(20261028)
number_of_folds <- 10L
fold_id <- integer(length(training_outcome))
for (outcome_level in sort(unique(training_outcome))) {
level_indices <- which(training_outcome == outcome_level)
fold_id[level_indices] <- sample(rep(
seq_len(number_of_folds),
length.out = length(level_indices)
))
}
lasso_cv_model <- glmnet::cv.glmnet(
x = training_design_matrix,
y = training_outcome,
family = "binomial",
alpha = 1,
foldid = fold_id,
type.measure = "deviance",
standardize = TRUE
)
lasso_coefficients <- as.numeric(
coef(lasso_cv_model, s = "lambda.1se")[-1, 1]
)
names(lasso_coefficients) <- colnames(training_design_matrix)
lasso_term_strength <- vapply(
seq_along(selection_term_labels),
function(term_index) {
max(abs(lasso_coefficients[design_assignment == term_index]))
},
numeric(1)
)
names(lasso_term_strength) <- selection_term_labels
lasso_selected_predictors <- names(lasso_term_strength)[
lasso_term_strength > 0
]
elastic_net_alpha_grid <- seq(0.1, 0.9, by = 0.1)
elastic_net_cv_models <- lapply(
elastic_net_alpha_grid,
function(alpha_value) {
glmnet::cv.glmnet(
x = training_design_matrix,
y = training_outcome,
family = "binomial",
alpha = alpha_value,
foldid = fold_id,
type.measure = "deviance",
standardize = TRUE
)
}
)
elastic_net_alpha_table <- data.frame(
Alpha = elastic_net_alpha_grid,
`Lambda (1se)` = vapply(
elastic_net_cv_models, function(m) m$lambda.1se, numeric(1)
),
`Minimum CV deviance` = vapply(
elastic_net_cv_models, function(m) min(m$cvm), numeric(1)
),
check.names = FALSE
)
best_alpha_index <- which.min(elastic_net_alpha_table$`Minimum CV deviance`)
elastic_net_alpha <- elastic_net_alpha_grid[best_alpha_index]
elastic_net_cv_model <- elastic_net_cv_models[[best_alpha_index]]
elastic_net_coefficients <- as.numeric(
coef(elastic_net_cv_model, s = "lambda.1se")[-1, 1]
)
names(elastic_net_coefficients) <- colnames(training_design_matrix)
elastic_net_term_strength <- vapply(
seq_along(selection_term_labels),
function(term_index) {
max(abs(elastic_net_coefficients[design_assignment == term_index]))
},
numeric(1)
)
names(elastic_net_term_strength) <- selection_term_labels
elastic_net_selected_predictors <- names(elastic_net_term_strength)[
elastic_net_term_strength > 0
]
elastic_net_alpha_table[c("Lambda (1se)", "Minimum CV deviance")] <- lapply(
elastic_net_alpha_table[c("Lambda (1se)", "Minimum CV deviance")],
round,
digits = 5
)
knitr::kable(
elastic_net_alpha_table,
align = c("r", "r", "r"),
caption = paste0(
"Cross-validated deviance by elastic-net mixing parameter (selected alpha = ",
elastic_net_alpha, ")"
)
)
full_selection_model <- glm(
formula = selection_formula,
data = selection_training_data,
family = binomial(link = "logit"),
na.action = na.fail
)
if (!isTRUE(full_selection_model$converged)) {
stop("The full model used for stepwise selection did not converge.")
}
stepwise_model <- MASS::stepAIC(
full_selection_model,
direction = "both",
trace = FALSE
)
if (!isTRUE(stepwise_model$converged)) {
stop("The stepwise logistic regression did not converge.")
}
stepwise_selected_predictors <- attr(
terms(stepwise_model),
"term.labels"
)
lasso_refit_formula <- reformulate(
termlabels = lasso_selected_predictors,
response = outcome_variable
)
elastic_net_refit_formula <- reformulate(
termlabels = elastic_net_selected_predictors,
response = outcome_variable
)
stepwise_refit_formula <- reformulate(
termlabels = stepwise_selected_predictors,
response = outcome_variable
)
lasso_refit_model <- glm(
formula = lasso_refit_formula,
data = selection_training_data,
family = binomial(link = "logit"),
na.action = na.fail
)
elastic_net_refit_model <- glm(
formula = elastic_net_refit_formula,
data = selection_training_data,
family = binomial(link = "logit"),
na.action = na.fail
)
stepwise_refit_model <- glm(
formula = stepwise_refit_formula,
data = selection_training_data,
family = binomial(link = "logit"),
na.action = na.fail
)
if (!isTRUE(lasso_refit_model$converged) || anyNA(coef(lasso_refit_model))) {
stop("The logistic model using LASSO-selected variables is not estimable.")
}
if (!isTRUE(elastic_net_refit_model$converged) || anyNA(coef(elastic_net_refit_model))) {
stop("The logistic model using elastic-net-selected variables is not estimable.")
}
if (!isTRUE(stepwise_refit_model$converged) || anyNA(coef(stepwise_refit_model))) {
stop("The logistic model using stepwise-selected variables is not estimable.")
}
selection_results_table <- data.frame(
`Candidate predictor` = candidate_predictors,
`Maximum absolute LASSO coefficient` = unname(
lasso_term_strength[candidate_predictors]
),
`Selected by LASSO` = ifelse(
candidate_predictors %in% lasso_selected_predictors,
"Yes",
"No"
),
`Maximum absolute elastic-net coefficient` = unname(
elastic_net_term_strength[candidate_predictors]
),
`Selected by elastic net` = ifelse(
candidate_predictors %in% elastic_net_selected_predictors,
"Yes",
"No"
),
`Selected by stepwise AIC` = ifelse(
candidate_predictors %in% stepwise_selected_predictors,
"Yes",
"No"
),
`Selected by all three methods` = ifelse(
candidate_predictors %in% Reduce(
intersect,
list(
lasso_selected_predictors,
elastic_net_selected_predictors,
stepwise_selected_predictors
)
),
"Yes",
"No"
),
check.names = FALSE
)
coefficient_strength_columns <- c(
"Maximum absolute LASSO coefficient",
"Maximum absolute elastic-net coefficient"
)
selection_results_table[coefficient_strength_columns] <- lapply(
selection_results_table[coefficient_strength_columns],
round,
digits = 4
)
knitr::kable(
selection_results_table,
align = c("l", "r", "c", "r", "c", "c", "c"),
caption = "Predictors selected independently by LASSO, elastic net and stepwise AIC"
)
logistic_coefficient_table <- function(model) {
coefficient_matrix <- summary(model)$coefficients
critical_value <- qnorm(0.975)
result <- data.frame(
Term = rownames(coefficient_matrix),
Coefficient = coefficient_matrix[, "Estimate"],
`Standard error` = coefficient_matrix[, "Std. Error"],
`Odds ratio` = exp(coefficient_matrix[, "Estimate"]),
`OR 95% CI lower` = exp(
coefficient_matrix[, "Estimate"] -
critical_value * coefficient_matrix[, "Std. Error"]
),
`OR 95% CI upper` = exp(
coefficient_matrix[, "Estimate"] +
critical_value * coefficient_matrix[, "Std. Error"]
),
`P value` = coefficient_matrix[, "Pr(>|z|)"],
check.names = FALSE,
row.names = NULL
)
numeric_columns <- setdiff(names(result), c("Term", "P value"))
result[numeric_columns] <- lapply(
result[numeric_columns],
round,
digits = 3
)
result$`P value` <- format.pval(
result$`P value`,
digits = 3,
eps = 0.001
)
result
}
lasso_coefficient_table <- logistic_coefficient_table(lasso_refit_model)
knitr::kable(
lasso_coefficient_table,
align = c("l", rep("r", 6)),
caption = paste(
"Logistic regression fitted with the variables selected by LASSO",
"in the 2020-2023 training period"
)
)
elastic_net_coefficient_table <- logistic_coefficient_table(
elastic_net_refit_model
)
knitr::kable(
elastic_net_coefficient_table,
align = c("l", rep("r", 6)),
caption = paste(
"Logistic regression fitted with the variables selected by elastic net",
"in the 2020-2023 training period"
)
)
stepwise_coefficient_table <- logistic_coefficient_table(stepwise_refit_model)
knitr::kable(
stepwise_coefficient_table,
align = c("l", rep("r", 6)),
caption = paste(
"Logistic regression fitted with the variables selected by stepwise AIC",
"in the 2020-2023 training period"
)
)
lasso_training_probability <- predict(
lasso_refit_model,
newdata = selection_training_data,
type = "response"
)
lasso_test_probability <- predict(
lasso_refit_model,
newdata = selection_test_data,
type = "response"
)
elastic_net_training_probability <- predict(
elastic_net_refit_model,
newdata = selection_training_data,
type = "response"
)
elastic_net_test_probability <- predict(
elastic_net_refit_model,
newdata = selection_test_data,
type = "response"
)
stepwise_training_probability <- predict(
stepwise_refit_model,
newdata = selection_training_data,
type = "response"
)
stepwise_test_probability <- predict(
stepwise_refit_model,
newdata = selection_test_data,
type = "response"
)
evaluate_selection_predictions <- function(
method,
sample_name,
observed,
predicted_probability,
number_of_selected_predictors
) {
roc_object <- pROC::roc(
response = observed,
predictor = predicted_probability,
levels = c(0, 1),
direction = "<",
quiet = TRUE
)
auc_confidence_interval <- as.numeric(
pROC::ci.auc(roc_object, method = "delong")
)
data.frame(
Method = method,
Sample = sample_name,
`Selected predictors` = number_of_selected_predictors,
N = length(observed),
Deaths = sum(observed),
AUC = calculate_auc(observed, predicted_probability),
`AUC 95% CI lower` = auc_confidence_interval[1],
`AUC 95% CI upper` = auc_confidence_interval[3],
`Brier score` = mean(
(observed - predicted_probability)^2
),
check.names = FALSE
)
}
selection_performance_table <- rbind(
evaluate_selection_predictions(
method = "Logistic model with LASSO-selected variables",
sample_name = "Training (2020-2023)",
observed = selection_training_data$mortality_30d,
predicted_probability = lasso_training_probability,
number_of_selected_predictors = length(lasso_selected_predictors)
),
evaluate_selection_predictions(
method = "Logistic model with LASSO-selected variables",
sample_name = "Validation (2024-2025)",
observed = selection_test_data$mortality_30d,
predicted_probability = lasso_test_probability,
number_of_selected_predictors = length(lasso_selected_predictors)
),
evaluate_selection_predictions(
method = "Logistic model with elastic-net-selected variables",
sample_name = "Training (2020-2023)",
observed = selection_training_data$mortality_30d,
predicted_probability = elastic_net_training_probability,
number_of_selected_predictors = length(elastic_net_selected_predictors)
),
evaluate_selection_predictions(
method = "Logistic model with elastic-net-selected variables",
sample_name = "Validation (2024-2025)",
observed = selection_test_data$mortality_30d,
predicted_probability = elastic_net_test_probability,
number_of_selected_predictors = length(elastic_net_selected_predictors)
),
evaluate_selection_predictions(
method = "Logistic model with stepwise-selected variables",
sample_name = "Training (2020-2023)",
observed = selection_training_data$mortality_30d,
predicted_probability = stepwise_training_probability,
number_of_selected_predictors = length(stepwise_selected_predictors)
),
evaluate_selection_predictions(
method = "Logistic model with stepwise-selected variables",
sample_name = "Validation (2024-2025)",
observed = selection_test_data$mortality_30d,
predicted_probability = stepwise_test_probability,
number_of_selected_predictors = length(stepwise_selected_predictors)
)
)
performance_columns <- c(
"AUC", "AUC 95% CI lower", "AUC 95% CI upper", "Brier score"
)
selection_performance_table[performance_columns] <- lapply(
selection_performance_table[performance_columns],
round,
digits = 3
)
knitr::kable(
selection_performance_table,
align = c("l", "l", rep("r", 7)),
caption = paste(
"Training (2020-2023) and validation (2024-2025) performance with DeLong 95% AUC confidence intervals",
"for the logistic models refitted after variable selection"
)
)
significance_threshold <- 0.05
eliminate_nonsignificant_predictors <- function(model, threshold) {
removed_predictors <- character(0)
repeat {
term_tests <- drop1(model, test = "Chisq")
term_tests <- term_tests[rownames(term_tests) != "<none>", , drop = FALSE]
if (nrow(term_tests) == 0L) break
p_values <- term_tests[["Pr(>Chi)"]]
worst_index <- which.max(p_values)
if (p_values[worst_index] < threshold) break
removed_term <- rownames(term_tests)[worst_index]
removed_predictors <- c(removed_predictors, removed_term)
model <- update(model, as.formula(paste(". ~ . -", removed_term)))
}
list(model = model, removed = removed_predictors)
}
lasso_significant <- eliminate_nonsignificant_predictors(
lasso_refit_model, significance_threshold
)
elastic_net_significant <- eliminate_nonsignificant_predictors(
elastic_net_refit_model, significance_threshold
)
stepwise_significant <- eliminate_nonsignificant_predictors(
stepwise_refit_model, significance_threshold
)
lasso_significant_model <- lasso_significant$model
elastic_net_significant_model <- elastic_net_significant$model
stepwise_significant_model <- stepwise_significant$model
removed_predictors_table <- data.frame(
Method = c("LASSO", "Elastic net", "Stepwise AIC"),
`Predictors before` = c(
length(lasso_selected_predictors),
length(elastic_net_selected_predictors),
length(stepwise_selected_predictors)
),
`Predictors after` = c(
length(attr(terms(lasso_significant_model), "term.labels")),
length(attr(terms(elastic_net_significant_model), "term.labels")),
length(attr(terms(stepwise_significant_model), "term.labels"))
),
`Removed predictors (in order of removal)` = vapply(
list(
lasso_significant$removed,
elastic_net_significant$removed,
stepwise_significant$removed
),
function(x) if (length(x) == 0L) "None" else paste(x, collapse = ", "),
character(1)
),
check.names = FALSE
)
knitr::kable(
removed_predictors_table,
align = c("l", "r", "r", "l"),
caption = "Predictors removed because of p >= 0.05 (likelihood-ratio test)"
)
knitr::kable(
logistic_coefficient_table(lasso_significant_model),
align = c("l", rep("r", 6)),
caption = "Logistic regression with LASSO-selected variables, significant predictors only (2020-2023 training period)"
)
knitr::kable(
logistic_coefficient_table(elastic_net_significant_model),
align = c("l", rep("r", 6)),
caption = "Logistic regression with elastic-net-selected variables, significant predictors only (2020-2023 training period)"
)
knitr::kable(
logistic_coefficient_table(stepwise_significant_model),
align = c("l", rep("r", 6)),
caption = "Logistic regression with stepwise-selected variables, significant predictors only (2020-2023 training period)"
)
significant_models <- list(
"Logistic model with LASSO-selected significant variables" =
lasso_significant_model,
"Logistic model with elastic-net-selected significant variables" =
elastic_net_significant_model,
"Logistic model with stepwise-selected significant variables" =
stepwise_significant_model
)
significant_performance_table <- do.call(
rbind,
lapply(names(significant_models), function(method_name) {
model <- significant_models[[method_name]]
number_of_predictors <- length(attr(terms(model), "term.labels"))
rbind(
evaluate_selection_predictions(
method = method_name,
sample_name = "Training (2020-2023)",
observed = selection_training_data$mortality_30d,
predicted_probability = predict(
model, newdata = selection_training_data, type = "response"
),
number_of_selected_predictors = number_of_predictors
),
evaluate_selection_predictions(
method = method_name,
sample_name = "Validation (2024-2025)",
observed = selection_test_data$mortality_30d,
predicted_probability = predict(
model, newdata = selection_test_data, type = "response"
),
number_of_selected_predictors = number_of_predictors
)
)
})
)
significant_performance_table[performance_columns] <- lapply(
significant_performance_table[performance_columns],
round,
digits = 3
)
knitr::kable(
significant_performance_table,
align = c("l", "l", rep("r", 7)),
caption = paste(
"Training (2020-2023) and validation (2024-2025) performance with",
"DeLong 95% AUC confidence intervals for the models restricted to",
"significant predictors"
)
)
