df_hosp <- df %>%
mutate(
mortalidad_real = ifelse(
evolucion_uci %in% c("exitus", "exitus y donacion"),
1, 0
)
) %>%
group_by(hospital) %>%
filter(n() >= 5) %>%
ungroup()
plot_ps <- df_hosp %>%
filter(!is.na(ps)) %>%
mutate(
muerte_esperada = ifelse(ps < 50, 1, 0)
) %>%
group_by(hospital) %>%
summarise(
n_pacientes = n(),
mortalidad_observada = mean(mortalidad_real) * 100,
mortalidad_esperada = mean(muerte_esperada) * 100,
desviacion = mortalidad_observada - mortalidad_esperada,
.groups = "drop"
)
ggplot(plot_ps, aes(x = n_pacientes, y = desviacion)) +
geom_hline(yintercept = 0, linewidth = 0.8) +
geom_point(color = "#56B4E9", size = 2, alpha = 0.8) +
labs(
title = "Desviación de mortalidad observada respecto a esperada según Ps",
x = "Número de pacientes",
y = "Mortalidad observada - esperada (%)"
) +
annotate(
"text",
x = max(plot_ps$n_pacientes) * 0.75,
y = max(plot_ps$desviacion),
label = "Más muertes\nque las esperadas"
) +
annotate(
"text",
x = max(plot_ps$n_pacientes) * 0.75,
y = min(plot_ps$desviacion),
label = "Menos muertes\nque las esperadas"
) +
theme_classic()
# 1. Crear tabla por hospital
plot_ps <- df_hosp %>%
filter(!is.na(ps)) %>%
mutate(
muerte_esperada = ifelse(ps < 50, 1, 0)
) %>%
group_by(hospital) %>%
summarise(
n_pacientes = n(),
mortalidad_observada = mean(mortalidad_real, na.rm = TRUE) * 100,
mortalidad_esperada = mean(muerte_esperada, na.rm = TRUE) * 100,
desviacion = mortalidad_observada - mortalidad_esperada,
.groups = "drop"
)
# 2. Mortalidad esperada global
p_esperada <- mean(df_hosp$ps < 50, na.rm = TRUE)
# 3. Límites del funnel plot
limites_funnel_ps <- data.frame(
n_pacientes = seq(
min(plot_ps$n_pacientes),
max(plot_ps$n_pacientes),
length.out = 300
)
) %>%
mutate(
limite_sup_95 = 100 * 1.96 * sqrt(p_esperada * (1 - p_esperada) / n_pacientes),
limite_inf_95 = -limite_sup_95,
limite_sup_998 = 100 * 3 * sqrt(p_esperada * (1 - p_esperada) / n_pacientes),
limite_inf_998 = -limite_sup_998
)
# 4. Gráfico funnel plot
ggplot(plot_ps, aes(x = n_pacientes, y = desviacion)) +
geom_hline(yintercept = 0, linewidth = 0.8, color = "grey40") +
geom_line(
data = limites_funnel_ps,
aes(x = n_pacientes, y = limite_sup_95),
inherit.aes = FALSE,
linetype = "dashed",
color = "grey40"
) +
geom_line(
data = limites_funnel_ps,
aes(x = n_pacientes, y = limite_inf_95),
inherit.aes = FALSE,
linetype = "dashed",
color = "grey40"
) +
geom_line(
data = limites_funnel_ps,
aes(x = n_pacientes, y = limite_sup_998),
inherit.aes = FALSE,
color = "grey20"
) +
geom_line(
data = limites_funnel_ps,
aes(x = n_pacientes, y = limite_inf_998),
inherit.aes = FALSE,
color = "grey20"
) +
geom_point(color = "#56B4E9", size = 2, alpha = 0.8) +
annotate(
"text",
x = max(plot_ps$n_pacientes) * 0.75,
y = max(limites_funnel_ps$limite_sup_998),
label = "Más muertes\nque las esperadas"
) +
annotate(
"text",
x = max(plot_ps$n_pacientes) * 0.75,
y = min(limites_funnel_ps$limite_inf_998),
label = "Menos muertes\nque las esperadas"
) +
labs(
title = "Funnel plot de mortalidad observada respecto a esperada según Ps",
x = "Número de pacientes",
y = "Mortalidad observada - esperada (%)"
) +
theme_classic()
# 1. Crear tabla por hospital
plot_retrascore <- df_hosp %>%
filter(!is.na(retrascore)) %>%
mutate(
muerte_esperada = ifelse(retrascore >= 10, 1, 0)
) %>%
group_by(hospital) %>%
summarise(
n_pacientes = n(),
mortalidad_observada = mean(mortalidad_real, na.rm = TRUE) * 100,
