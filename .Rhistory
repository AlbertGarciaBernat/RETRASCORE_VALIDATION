# Crear variable binaria de mortalidad real
df <- df %>%
mutate(
mortalidad_real = ifelse(evolucion_uci %in% c("exitus", "exitus y donacion"), 1, 0),
mortalidad_real_txt = ifelse(mortalidad_real == 1, "Exitus", "Alta"),
# Predicción según puntos de corte
pred_retrascore = ifelse(retrascore >= 10, 1, 0),
pred_retrascore_txt = ifelse(pred_retrascore == 1, "Predice exitus", "Predice alta"),
pred_ps = ifelse(ps < 50, 1, 0),
pred_ps_txt = ifelse(pred_ps == 1, "Predice exitus", "Predice alta")
)
ggplot(df, aes(x = pred_retrascore_txt, fill = mortalidad_real_txt)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Mortalidad real según RETRAscore",
x = "Clasificación por RETRAscore",
y = "Porcentaje",
fill = "Evolución UCI"
) +
theme_minimal()
ggplot(df, aes(x = pred_ps_txt, fill = mortalidad_real_txt)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Mortalidad real según Ps",
x = "Clasificación por Ps",
y = "Porcentaje",
fill = "Evolución UCI"
) +
theme_minimal()
df <- df %>%
mutate(
mortalidad_real = ifelse(evolucion_uci %in% c("exitus", "exitus y donacion"), 1, 0),
mortalidad_real_txt = ifelse(mortalidad_real == 1, "Exitus", "Alta"),
# Predicción según puntos de corte
pred_retrascore = ifelse(retrascore >= 11, 1, 0),
pred_retrascore_txt = ifelse(pred_retrascore == 1, "Predice exitus", "Predice alta"),
pred_ps = ifelse(ps < 40, 1, 0),
pred_ps_txt = ifelse(pred_ps == 1, "Predice exitus", "Predice alta")
)
n_pacientes <- 19000
df_muestra <- df %>%
filter(!is.na(ps), !is.na(mortalidad_real_txt))
df_muestra <- df_muestra %>%
