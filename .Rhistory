variables_seleccionadas_1se = length(predictores_lasso)
)
knitr::kable(resumen_lasso, digits = 5, caption = "Resumen del LASSO")
knitr::kable(tabla_lasso, digits = 5, caption = "Coeficientes y seleccion LASSO")
formula_modelo <- if (length(predictores_lasso)) {
reformulate(predictores_lasso, response = "mortalidad_30d")
} else {
mortalidad_30d ~ 1
}
modelo_logistico <- glm(
formula_modelo,
data = datos_derivacion,
family = binomial(link = "logit")
)
stopifnot(modelo_logistico$converged)
if (anyNA(coef(modelo_logistico))) {
stop("Hay coeficientes no estimables; revise colinealidad o niveles vacios.")
}
calcular_auc <- function(outcome, probabilidad) {
casos <- outcome == 1
controles <- outcome == 0
n_casos <- sum(casos)
n_controles <- sum(controles)
if (!n_casos || !n_controles) return(NA_real_)
rangos <- rank(probabilidad, ties.method = "average")
(sum(rangos[casos]) - n_casos * (n_casos + 1) / 2) /
(n_casos * n_controles)
}
evaluar_modelo <- function(modelo, datos, muestra) {
probabilidad <- predict(modelo, newdata = datos, type = "response")
predictor_lineal <- predict(modelo, newdata = datos, type = "link")
modelo_intercepto <- glm(
mortalidad_30d ~ 1,
offset = predictor_lineal,
data = datos,
family = binomial(link = "logit")
)
modelo_pendiente <- glm(
mortalidad_30d ~ predictor_lineal,
data = datos,
family = binomial(link = "logit")
)
data.frame(
muestra = muestra,
n = nrow(datos),
muertes_30d = sum(datos$mortalidad_30d),
mortalidad_pct = 100 * mean(datos$mortalidad_30d),
auc = calcular_auc(datos$mortalidad_30d, probabilidad),
brier = mean((datos$mortalidad_30d - probabilidad)^2),
intercepto_calibracion = unname(coef(modelo_intercepto)[1]),
pendiente_calibracion = unname(coef(modelo_pendiente)[2]),
row.names = NULL
)
}
tabla_rendimiento <- rbind(
evaluar_modelo(
modelo_logistico,
datos_derivacion,
paste0(anio_inicio, "-", anio_fin_derivacion)
),
evaluar_modelo(
modelo_logistico,
datos_validacion,
paste0(anio_inicio_validacion, "-", anio_fin_estudio)
)
)
coeficientes <- summary(modelo_logistico)$coefficients
tabla_coeficientes <- data.frame(
termino = rownames(coeficientes),
beta = coeficientes[, "Estimate"],
error_estandar = coeficientes[, "Std. Error"],
p = coeficientes[, "Pr(>|z|)"],
OR = exp(coeficientes[, "Estimate"]),
IC95_inferior = exp(
coeficientes[, "Estimate"] - 1.96 * coeficientes[, "Std. Error"]
),
IC95_superior = exp(
coeficientes[, "Estimate"] + 1.96 * coeficientes[, "Std. Error"]
),
row.names = NULL
)
formula_modelo
knitr::kable(
data.frame(variable = predictores_lasso),
caption = "Variables incluidas en el modelo post-LASSO"
)
knitr::kable(tabla_coeficientes, digits = 4, caption = "Modelo logistico")
knitr::kable(tabla_rendimiento, digits = 3, caption = "Rendimiento del modelo")
